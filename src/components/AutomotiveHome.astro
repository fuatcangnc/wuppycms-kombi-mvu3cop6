          >
            <ArrowRight class="size-5" />
          </button>
        </div>
      </div>
    </section>

    <!-- Form Section (Hızlı Teklif & Danışmanlık) -->
    <section class="border-y border-neutral-200 bg-[#f8f9fa] py-20 lg:py-28 [content-visibility:auto] [contain-intrinsic-size:auto_1100px]" id="proje-talebi">
      <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16 items-center">
        <!-- Left Column: Authority, Value Points & Direct Contact -->
        <div class="lg:col-span-5 flex flex-col justify-between" data-reveal>
          <div>
            <div class="inline-block">
              <span class="inline-block -skew-x-12 bg-neutral-950 px-4 py-1 text-[11px] font-black uppercase tracking-[0.2em] text-white">
                <span class="inline-block skew-x-12">HIZLI TEKLİF & DANIŞMANLIK</span>
              </span>
            </div>
            
            <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-black uppercase leading-[1.06] tracking-tight text-neutral-950">
              Araç Projesi ve Çanta Tescili İçin <span class="text-primary">Anında Teklif Alın</span>
            </h2>
            
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-neutral-600 font-normal">
              Aracınızın veya motosikletinizin ruhsat ve tadilat detaylarını iletin; TSE 360 onay adımlarını, resmi harçları ve mühendislik bedelini dakikalar içinde netleştirelim.
            </p>

            <!-- Structured Value Steps -->
            <div class="mt-8 space-y-3">
              <div class="flex items-start gap-3.5 p-3.5 border border-neutral-200 bg-white">
                <div class="grid size-7 shrink-0 place-items-center bg-primary text-white font-mono font-black text-xs">01</div>
                <div>
                  <h3 class="text-xs font-black uppercase tracking-tight text-neutral-950">Aynı Gün TSE 360 İncelemesi</h3>
                  <p class="text-xs text-neutral-600 mt-0.5 leading-normal">Teknik hesaplamalar ve proje çizimi yapılarak dosyanız aynı gün sisteme yüklenir.</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5 p-3.5 border border-neutral-200 bg-white">
                <div class="grid size-7 shrink-0 place-items-center bg-primary text-white font-mono font-black text-xs">02</div>
                <div>
                  <h3 class="text-xs font-black uppercase tracking-tight text-neutral-950">Türkiye Geneli Yetkili Hizmet</h3>
                  <p class="text-xs text-neutral-600 mt-0.5 leading-normal">81 ilde binek otomobiller, ticari araçlar ve kurye filoları için eksiksiz mühendislik.</p>
                </div>
              </div>

              <div class="flex items-start gap-3.5 p-3.5 border border-neutral-200 bg-white">
                <div class="grid size-7 shrink-0 place-items-center bg-primary text-white font-mono font-black text-xs">03</div>
                <div>
                  <h3 class="text-xs font-black uppercase tracking-tight text-neutral-950">%100 Ruhsat & Tescil Güvencesi</h3>
                  <p class="text-xs text-neutral-600 mt-0.5 leading-normal">TÜVTÜRK tespit muayenesi ve noter ruhsat basımında sıfır hata ve tam güvence.</p>
                </div>
              </div>
            </div>

            <!-- Direct Engineer Support Callout -->
            <div class="mt-8 border-l-4 border-primary bg-neutral-950 p-6 text-white shadow-md">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-primary">Doğrudan Yetkili Mühendis Hattı</span>
                <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 border border-emerald-800/60">
                  <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Çevrimiçi
                </span>
              </div>
              <div class="mt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <a href={phoneHref} class="text-2xl font-black text-white hover:text-primary transition-colors tracking-tight">
                  +90 000 000 00 00
                </a>
                <a
                  href={whatsappHref('Merhaba, araç projesi ve motosiklet çanta tescili için teklif almak istiyorum.')}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex min-h-11 items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1fb65a] text-white px-5 text-xs font-black uppercase tracking-wider transition-all duration-200 hover:scale-[1.02] shadow-sm"
                >
                  <span>WhatsApp İle Sorun</span>
                  <ArrowRight class="size-4" />
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Proposal Form -->
        <div class="lg:col-span-7" data-reveal>
          <ProjectForm services={defaultServices} hideHeading />
        </div>
      </div>
    </section>

    <!-- Blog & Knowledge Base -->
    <section class="bg-white py-20 md:py-24 [content-visibility:auto] [contain-intrinsic-size:auto_1000px]">
      <div class="shell">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <h3 class="mx-auto w-fit -skew-x-12 bg-primary px-7 py-3 text-xs font-black uppercase italic tracking-[.12em] text-white">
            <span class="block skew-x-12">Bilgi Merkezi</span>
          </h3>
          <h2 class="mt-6 text-4xl font-black uppercase leading-none tracking-[-.055em] text-slate-950 md:text-6xl">Blog ve Teknik Rehberler</h2>
          <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-black/70">Araç proje çizimi, motosiklet çanta işletme, TSE 360 ve ruhsat tescil süreçlerinde doğru karar vermeniz için güncel makaleler.</p>
        </div>
        <div class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
          {posts.slice(0, 3).map((post, index) => <BlogCard post={post} index={index + 1} />)}
        </div>
      </div>
    </section>

    <!-- SSS (FAQ) -->
    <section class="bg-white py-20 md:py-24 [content-visibility:auto] [contain-intrinsic-size:auto_1100px]" id="sik-sorulan-sorular">
      <div class="shell">
        <div class="grid items-end gap-5 md:grid-cols-[10rem_1fr]" data-reveal>
          <h3 class="w-fit -skew-x-12 bg-primary px-7 py-3 text-xs font-black uppercase italic tracking-[.12em] text-white">
            <span class="block skew-x-12">SSS</span>
          </h3>
          <div>
            <h2 class="text-4xl font-black uppercase leading-none tracking-[-.055em] text-slate-950 md:text-6xl">
              Araç Projesi ve Çanta Tescili Hakkında Merak Edilenler
            </h2>
            <p class="mt-4 text-sm leading-7 text-black/70">Mevzuat, onay adımları ve tescil süreçlerinde bilmeniz gerekenler.</p>
          </div>
        </div>
        <div class="mt-14 grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:gap-16">
          <div class="relative min-h-[22rem] overflow-hidden md:min-h-[31rem]" data-reveal>
            <SiteImage class="absolute inset-0 size-full object-cover" src="/arac-proje-hizmetleri-sik-sorulan-sorular.webp" alt="Araç proje hizmetleri hakkında sık sorulan sorular" loading="lazy" />
          </div>
          <div data-reveal>
            <Accordion type="single">
              {
                faqs.map(([question, answer], index) => (
                  <AccordionItem value={`faq-${index}`} open={index === 0}>
                    <AccordionTrigger>
                      {question}
                    </AccordionTrigger>
                    <AccordionContent>
                      {answer}
                    </AccordionContent>
                  </AccordionItem>
                ))
              }
            </Accordion>
          </div>
        </div>
        <div class="relative z-10 mt-10 grid gap-5 sm:gap-6 overflow-visible p-6 sm:p-8 text-white md:-mt-16 md:mr-10 md:ml-16 md:grid-cols-[1.2fr_auto_1fr] md:items-center md:px-14 md:py-8">
          <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 to-slate-900 border-l-4 border-primary md:border-l-0 md:[clip-path:polygon(5%_0%,100%_0,100%_100%,0%_100%)] shadow-2xl">
            <span class="hidden md:block absolute -left-5 top-0 h-full w-12 -skew-x-12 bg-primary" aria-hidden="true"></span>
          </div>
          <h3 class="relative text-xl sm:text-2xl lg:text-[30px] font-black uppercase italic leading-tight tracking-tight text-white">
            <span class="block">Bir Sorunuz mu Var?</span>
            <span class="block text-amber-400">Mühendislerimize Danışın.</span>
          </h3>
          <span class="hidden h-24 w-px bg-primary md:block" aria-hidden="true"></span>
          <p class="max-w-md text-sm sm:text-base leading-relaxed text-neutral-200">Araç veya motosiklet ruhsatınızı WhatsApp'tan iletin, TSE onay adımlarını ve resmi harçları anında paylaşalım.</p>
          <a
            class="inline-flex w-full items-center justify-center gap-3 bg-primary hover:bg-white hover:text-slate-950 text-white font-black uppercase text-xs sm:text-sm py-3.5 px-6 transition-all duration-300 shadow-lg md:absolute md:right-[-2.5rem] md:top-1/2 md:-translate-y-1/2 md:size-20 md:shrink-0 md:p-0 md:grid md:place-items-center"
            href={whatsappHref('Merhaba, araç projesi ve motosiklet çanta ruhsata işletme hakkında danışmak istiyorum.')}
            target="_blank"
            rel="noreferrer"
            aria-label="WhatsApp ile iletişime geçin"
          >
            <span class="md:hidden">WhatsApp İle Danışın</span>
            <ArrowRight size={20} class="md:size-7" />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const serviceCarousel = document.querySelector('[data-service-carousel]')
  document.querySelector('[data-service-prev]')?.addEventListener('click', () => {
    serviceCarousel?.scrollBy({ left: -(serviceCarousel.clientWidth / 2), behavior: 'smooth' })
  })
  document.querySelector('[data-service-next]')?.addEventListener('click', () => {
    serviceCarousel?.scrollBy({ left: serviceCarousel.clientWidth / 2, behavior: 'smooth' })
  })

  const testimonialCarousel = document.querySelector('[data-testimonial-carousel]')
  document.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => testimonialCarousel?.scrollBy({ left: -(testimonialCarousel.clientWidth / 3), behavior: 'smooth' }))
  document.querySelector('[data-testimonial-next]')?.addEventListener('click', () => testimonialCarousel?.scrollBy({ left: testimonialCarousel.clientWidth / 3, behavior: 'smooth' }))
</script>
