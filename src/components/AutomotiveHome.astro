---
import { ArrowLeft, ArrowRight, BadgeCheck, Bike, CarFront, Check, CircleCheck, FileCheck, Phone, ShieldCheck, Wrench } from '@lucide/astro'
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import BlogCard from '@/components/BlogCard.astro'
import ProjectForm from '@/components/ProjectForm.astro'
import ServiceCard from '@/components/ServiceCard.astro'
import ServiceCarousel from '@/components/ServiceCarousel.astro'
import InteractiveVehicleBlueprint from '@/components/InteractiveVehicleBlueprint.astro'
import CarBrandsMarquee from '@/components/CarBrandsMarquee.astro'
import WhyChooseUs from '@/components/WhyChooseUs.astro'
import { defaultServices, phoneHref, siteSettings, whatsappHref, courierCompanies } from '@/data/site'
import content from '@/data/content.json'
import { Carousel, CarouselSlide } from '@/ui/carousel'
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/ui/accordion'
import SiteImage from '@/components/SiteImage.astro'

const siteUrl = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '')

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': siteSettings.brandName,
      'description': siteSettings.heroDescription,
      'publisher': {
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'AutomotiveBusiness',
      '@id': `${siteUrl}/#organization`,
      'name': siteSettings.brandName,
      'url': siteUrl,
      'logo': `${siteUrl}/favicon.svg`,
      'image': `${siteUrl}/og-image.webp`,
      'telephone': siteSettings.phone,
      'email': siteSettings.email,
      'priceRange': '₺₺',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Örnek Mahallesi No: 1',
        'addressLocality': siteSettings.location,
        'addressRegion': 'İstanbul',
        'addressCountry': 'TR',
      },
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          'opens': '09:00',
          'closes': '19:00',
        },
      ],
      'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'TSE Onaylı Araç Proje ve Motosiklet Çanta Ruhsata İşletme Hizmetleri',
        'itemListElement': [
          {
            '@type': 'Offer',
            'itemOffered': {
              '@type': 'Service',
              'name': 'Araç Proje | TSE Onaylı',
              'url': `${siteUrl}/arac-proje-hizmetlerimiz`,
              'description': 'TSE AİTM onaylı araç tadilat, karavan dönüşümü, motor değişimi, çeki demiri ve koltuk söküm projeleri.',
            },
          },
          {
            '@type': 'Offer',
            'itemOffered': {
              '@type': 'Service',
              'name': 'Motosiklet Çanta Ruhsata İşletme | TSE Onaylı',
              'url': `${siteUrl}/motosiklet-canta-ruhsata-isletme`,
              'description': 'Motosiklet arka çanta, kurye taşıma kutusu ve şase değişimi ruhsata işletme projesi.',
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      'mainEntity': [
        {
          '@type': 'Question',
          'name': 'Motosiklet çanta ruhsata nasıl işletilir?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Motosiklete monte edilen arka çanta veya taşıma kutusu için yetkili makine mühendisimiz tarafından TSE onaylı tadilat projesi çizilir. Ardından TSE Araç Kontrol Merkezi incelemesi ve TÜVTÜRK tespit muayenesi yapılarak noterden yeni ruhsat teslim alınır.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Araç projesi hangi durumlarda zorunludur?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Karavan dönüşümü, motor değişimi, çeki demiri montajı, koltuk sökümü veya ilavesi, LPG sökümü, engelli aparatı ve sürücü kursu çift pedal montajı gibi aracın fabrika çıkış özelliklerini değiştiren tüm işlemlerde yasal olarak araç projesi zorunludur.',
          },
        },
        {
          '@type': 'Question',
          'name': 'TSE onay ve ruhsat süreci ne kadar sürer?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Teknik evraklarınız ve montaj faturanız hazır olduğunda proje çizimi ve TSE 360 sistemine dosya yükleme işlemi aynı gün içinde tamamlanır. Randevu sonrasında muayene ve noter tesciliyle süreç hızla sonuçlandırılır.',
          },
        },
        {
          '@type': 'Question',
          'name': 'Kurye firmaları için toplu çanta işletme desteği var mı?',
          'acceptedAnswer': {
            '@type': 'Answer',
            'text': 'Evet. Getir, Trendyol Go, Yemeksepeti, Vigo, Paket Taxi ve kurumsal kurye filoları için toplu motosiklet çanta ruhsata işletme ve teknik danışmanlık hizmeti sunuyoruz.',
          },
        },
      ],
    },
  ],
}

const orderedServices = [...defaultServices].sort((a, b) => {
  if (Boolean(a.featured) !== Boolean(b.featured)) {
    return a.featured ? -1 : 1
  }
  return a.order - b.order
})

const vehicleServices = defaultServices.filter((s) => s.category !== 'Motosiklet')

const posts = (await getCollection('posts')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())

const processSteps = [
  ['01', 'Ruhsat ve Teknik Evrak Kontrolü', 'Araç veya motosiklet ruhsatı, tadilat faturası, uygunluk belgesi ve teknik montaj detayları TSE yetkili makine mühendisimizce incelenir.'],
  ['02', 'TSE Proje Çizimi ve Hesap Raporu', 'Sanayi Bakanlığı AİTM mevzuatına tam uyumlu teknik çizim, mukavemet ve ağırlık dağılımı mühendislik hesapları hazırlanır.'],
  ['03', 'TSE 360 Dijital Dosya Onayı', 'Hazırlanan tadilat projesi TSE 360 sistemine yüklenir; Araç Kontrol Merkezinde (AKM) dijital inceleme ve resmi onay tamamlanır.'],
  ['04', 'TÜVTÜRK Muayenesi ve Noter Tescili', 'TÜVTÜRK tadilat tespit muayenesi sonrası notere gidilerek yeni araç veya motosiklet ruhsatı aynı gün içinde teslim alınır.'],
  ['05', 'Resmi Ruhsat ve Trafik Tescili', 'Tüm yasal ve teknik onaylar eksiksiz tamamlanarak aracınız yasal güvenceyle trafiğe hazır hale getirilir.'],
]

const faqs = [
  ['Motosiklet çanta ruhsata nasıl işletilir?', 'Motosiklete monte edilen arka çanta veya taşıma kutusu için yetkili makine mühendisimiz tarafından TSE onaylı tadilat projesi çizilir. Ardından TSE Araç Kontrol Merkezi incelemesi ve TÜVTÜRK tespit muayenesi yapılarak noterden yeni ruhsat teslim alınır.'],
  ['Araç projesi hangi durumlarda zorunludur?', 'Karavan dönüşümü, motor değişimi, çeki demiri montajı, koltuk sökümü veya ilavesi, LPG sökümü, engelli aparatı ve sürücü kursu çift pedal montajı gibi aracın fabrika çıkış özelliklerini değiştiren tüm işlemlerde yasal olarak araç projesi zorunludur.'],
  ['TSE onay ve ruhsat süreci ne kadar sürer?', 'Teknik evraklarınız ve montaj faturanız hazır olduğunda proje çizimi ve TSE 360 sistemine dosya yükleme işlemi aynı gün içinde tamamlanır. Randevu sonrasında muayene ve noter tesciliyle süreç hızla sonuçlandırılır.'],
  ['Kurye firmaları için toplu çanta işletme desteği var mı?', 'Evet. Getir, Trendyol Go, Yemeksepeti, Vigo, Paket Taxi ve kurumsal kurye filoları için toplu motosiklet çanta ruhsata işletme ve teknik danışmanlık hizmeti sunuyoruz.'],
]
---

<Layout
  title={`${siteSettings.brandName} | ${content.heroTitle || 'Araç Proje Hizmetleri'}`}
  description={content.heroDescription || siteSettings.heroDescription}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="home">

    <!-- Ultra-Premium Light Mode Hero Section -->
    <section class="py-4 sm:py-6 lg:py-8 mb-8 sm:mb-12 lg:mb-16">
      <div class="mx-auto w-[95vw]">
        <div class="relative isolate flex min-h-[580px] sm:min-h-[640px] lg:min-h-[700px] items-center overflow-hidden rounded-none bg-white text-black shadow-[0_20px_50px_-20px_rgba(0,0,0,0.08)] border border-neutral-300 px-6 py-12 sm:px-12 sm:py-16 lg:px-16 lg:py-20">
          <!-- Neutral Technical Dot Matrix Pattern -->
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e5e5_1.5px,transparent_1.5px)] [background-size:24px_24px] opacity-70" aria-hidden="true"></div>
          <!-- Subtle warm ambient lighting -->
          <div class="absolute -right-20 -top-20 -z-10 size-96 rounded-full bg-primary/5 blur-3xl" aria-hidden="true"></div>
          <div class="absolute -left-20 -bottom-20 -z-10 size-96 rounded-full bg-neutral-900/5 blur-3xl" aria-hidden="true"></div>

          <div class="grid w-full grid-cols-1 items-center gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-14 xl:gap-16">
            <!-- Left Column -->
            <div class="w-full">
              <!-- Precision Eyebrow Pill -->
              <div class="inline-flex items-center gap-2.5 border border-neutral-300 bg-neutral-100 px-3.5 py-1.5 text-[11px] sm:text-xs font-black uppercase tracking-[0.14em] text-black shadow-2xs">
                <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                <span>TSE 360 & TÜVTÜRK YETKİLİ ARAÇ PROJE OFİSİ</span>
              </div>

              <!-- Main Title with Target Keywords -->
              <h1 class="mt-5 text-2xl sm:text-3xl md:text-4xl lg:text-[38px] font-black uppercase text-black tracking-[-0.03em] leading-[1.1]">
                <span class="text-primary">ARAÇ PROJE</span> HİZMETLERİ VE<br />
                <span class="text-primary">MOTOSİKLET ÇANTA</span> RUHSATA İŞLETME <span class="text-primary">| TSE ONAYLI</span>
              </h1>

              <!-- Extended Description with Primary Keyword Context -->
              <p class="mt-4 max-w-2xl lg:max-w-3xl text-base sm:text-lg text-neutral-800 leading-relaxed font-medium">
                Yetkili makine mühendisliği kadromuzla; otomobil ve ticari araçlarda TSE onaylı araç proje çizimi yaparken, kurye ve bireysel motosikletlerde motosiklet çanta ruhsata işletme ve şase tescil süreçlerini hızlı, eksiksiz ve mevzuata tam uyumlu olarak yönetiyoruz.
              </p>

              <!-- Quick Trust & Feature Points -->
              <div class="mt-5 flex flex-wrap items-center gap-2.5 text-xs font-bold text-black">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-neutral-50 border border-neutral-300 shadow-2xs">
                  <CircleCheck size={14} class="text-primary" /> Araç Proje | TSE Onaylı
                </span>
                <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-neutral-50 border border-neutral-300 shadow-2xs">
                  <CircleCheck size={14} class="text-primary" /> Motosiklet Çanta Ruhsata İşletme
                </span>
                <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-neutral-50 border border-neutral-300 shadow-2xs">
                  <CircleCheck size={14} class="text-primary" /> TÜVTÜRK & Noter Tescil Desteği
                </span>
              </div>

              <!-- Authority Metrics Bar -->
              <div class="mt-7 grid grid-cols-3 gap-6 border-y border-neutral-200 py-5 max-w-xl">
                <div>
                  <strong class="block text-2xl sm:text-3xl font-black text-black tracking-tight">12+ Yıl</strong>
                  <span class="text-[11px] sm:text-xs font-bold text-neutral-600 uppercase tracking-wider">Mühendislik Deneyimi</span>
                </div>
                <div class="border-l border-neutral-200 pl-6">
                  <strong class="block text-2xl sm:text-3xl font-black text-black tracking-tight">1.000+</strong>
                  <span class="text-[11px] sm:text-xs font-bold text-neutral-600 uppercase tracking-wider">Tescilli Proje</span>
                </div>
                <div class="border-l border-neutral-200 pl-6">
                  <strong class="block text-2xl sm:text-3xl font-black text-primary tracking-tight">%100</strong>
                  <span class="text-[11px] sm:text-xs font-bold text-neutral-600 uppercase tracking-wider">Mevzuat Uyumu</span>
                </div>
              </div>

              <!-- Dual CTAs -->
              <div class="mt-7 flex flex-wrap items-center gap-4">
                <a
                  href="https://www.tuvturk.com.tr/hizmetlerimiz/hizli-islemler/arac-muayene-randevusu-alma"
                  target="_blank"
                  rel="noreferrer"
                  class="group inline-flex items-center justify-center gap-3 bg-primary hover:bg-[#b84d12] text-white font-black uppercase text-xs sm:text-[13px] tracking-wider px-8 py-4.5 transition-all duration-300 hover:scale-[1.02] shadow-lg shadow-primary/25"
                >
                  <span>TÜVTÜRK RANDEVU AL</span>
                  <ArrowRight size={16} class="group-hover:translate-x-1 transition-transform" />
                </a>

                <a
                  href={whatsappHref('Merhaba, araç projesi ve motosiklet çanta ruhsata işletme hizmetleriniz hakkında bilgi almak istiyorum.')}
                  target="_blank"
                  rel="noreferrer"
                  class="group inline-flex items-center justify-center gap-3 bg-white hover:bg-black border-2 border-black text-black hover:text-white font-black uppercase text-xs sm:text-[13px] tracking-wider px-8 py-4.5 transition-all duration-300 hover:scale-[1.02] shadow-sm hover:shadow-md"
                >
                  <span>WHATSAPP İLE TEKLİF AL</span>
                  <ArrowRight size={16} class="group-hover:translate-x-1 transition-transform" />
                </a>
              </div>

              <!-- Google Rating Card -->
              <a
                href={siteSettings.googleReviewsUrl}
                target="_blank"
                rel="noreferrer"
                aria-label="Google değerlendirmelerimizi inceleyin"
                class="mt-7 inline-flex items-center gap-3.5 border border-neutral-300 bg-white p-3 text-black shadow-2xs transition hover:border-primary/60 hover:shadow-md"
              >
                <span class="grid size-10 place-items-center bg-neutral-100 border border-neutral-300">
                  <svg aria-hidden="true" class="size-6" viewBox="-0.5 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9.827 24c0-1.524.253-2.986.705-4.356l-7.909-6.04A23.58 23.58 0 0 0 .214 24c0 3.737.867 7.261 2.406 10.388l7.905-6.051A14.052 14.052 0 0 1 9.827 24" fill="#FBBC05" />
                    <path d="M23.714 10.133c3.31 0 6.302 1.174 8.652 3.094L39.202 6.4C35.036 2.773 29.695.533 23.714.533c-9.287 0-17.268 5.311-21.09 13.071l7.909 6.04c1.822-5.532 7.017-9.511 13.181-9.511" fill="#EB4335" />
                    <path d="M23.714 37.867c-6.165 0-11.36-3.979-13.182-9.511l-7.909 6.039c3.822 7.761 11.803 13.072 21.091 13.072 5.732 0 11.204-2.035 15.311-5.849l-7.507-5.804c-2.118 1.334-4.785 2.053-7.804 2.053" fill="#34A853" />
                    <path d="M46.145 24c0-1.387-.213-2.88-.534-4.267H23.714V28.8h12.604c-.63 3.091-2.346 5.468-4.8 7.014l7.507 5.804C43.339 37.614 46.145 31.649 46.145 24" fill="#4285F4" />
                  </svg>
                </span>
                <div class="leading-tight text-left">
                  <div class="flex items-center gap-2 text-sm font-black text-black">
                    <span>5/5.0</span>
                    <span class="tracking-widest text-[#f59e0b]">★★★★★</span>
                  </div>
                  <p class="mt-0.5 text-xs text-neutral-600 font-medium">Google'da Yüzlerce 5 Yıldızlı Değerlendirme</p>
                </div>
              </a>
            </div>

            <!-- Right Column: Interactive Vehicle Blueprint -->
            <div class="relative hidden w-full max-w-[620px] lg:max-w-none mx-auto lg:block">
              <InteractiveVehicleBlueprint />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Car Brands Marquee (Bejamas UI) -->
    <CarBrandsMarquee />

    <!-- Services Carousel -->
    <ServiceCarousel services={defaultServices.filter((s) => s.slug !== 'mobil-hizmet-ve-yol-yardim-araci-projesi')} />

    <!-- Two Main Core Pillars: Araç Proje & Motosiklet Çanta Ruhsata İşletme (Directly Below Services) -->
    <!-- Two Main Core Pillars: Araç Proje & Motosiklet Çanta Ruhsata İşletme (Directly Below Services) -->
    <section class="border-y border-neutral-200 bg-white py-20 lg:py-28 [content-visibility:auto] [contain-intrinsic-size:auto_1100px]" id="uzmanlik-alanlari">
      <div class="shell">
        <!-- Section Header in Site's Signature Industrial Style -->
        <div class="text-center max-w-4xl mx-auto mb-16" data-reveal>
          <div class="inline-block">
            <span class="inline-block -skew-x-12 bg-neutral-950 px-5 py-1.5 text-xs font-black uppercase tracking-[0.2em] text-white">
              <span class="inline-block skew-x-12">TSE YETKİLİ UZMANLIK MERKEZİ</span>
            </span>
          </div>
          <h2 class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-neutral-950 leading-tight">
            Araç Projesi ve Motosiklet Çanta Tescilinde <span class="text-primary">İki Ana Uzmanlık</span>
          </h2>
          <p class="mt-4 text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed">
            İhtiyacınız olan hizmet alanını seçin; mevzuata tam uygun teknik hesaplama, TSE 360 dijital dosya onayı ve noter tescil adımlarını sıfır hata güvencesiyle tamamlayalım.
          </p>
        </div>

        <!-- 2 Architectural Industrial Panels -->
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-12" data-reveal>
          
          <!-- Panel 1: Araç Proje & Tadilat Mühendisliği -->
          <div class="flex flex-col justify-between border border-neutral-200 bg-neutral-50/50 p-8 sm:p-10 border-t-4 border-t-primary shadow-xs transition-colors hover:border-neutral-300">
            <div>
              <!-- Header Bar -->
              <div class="flex items-center justify-between border-b border-neutral-200 pb-4">
                <div class="flex items-center gap-2.5">
                  <span class="grid size-8 place-items-center bg-primary text-white text-xs font-black">01</span>
                  <div>
                    <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-neutral-950">Araç Proje Hizmetleri</h3>
                    <h4 class="text-[11px] font-bold uppercase tracking-wider text-primary">TSE & AİTM Onaylı Mühendislik</h4>
                  </div>
                </div>
                <span class="hidden sm:inline-block text-[11px] font-black uppercase tracking-wider text-neutral-400 bg-white border border-neutral-200 px-2.5 py-1">Otomobil & Ticari</span>
              </div>

              <p class="mt-5 text-sm text-neutral-600 leading-relaxed">
                Sanayi ve Teknoloji Bakanlığı AİTM yönetmeliğine uygun araç tadilat, karavan dönüşüm, motor değişimi ve çeki demiri projelerini aynı gün TSE 360 sistemine işliyoruz.
              </p>

              <!-- Technical Service List (Clean Industrial Rows) -->
              <div class="mt-6">
                <div class="flex items-center justify-between border-b border-neutral-200 pb-2 mb-1">
                  <span class="text-[11px] font-black uppercase tracking-wider text-neutral-500">Sık Yapılan Araç Projeleri</span>
                  <a href="/arac-proje-hizmetlerimiz" class="text-[11px] font-black uppercase tracking-wider text-primary hover:text-neutral-950 transition-colors">Tüm Projeler (15+) →</a>
                </div>

                <div class="divide-y divide-neutral-200 border-b border-neutral-200">
                  <a href="/karavan-projesi" class="group flex items-center justify-between py-3 px-1 transition-colors hover:bg-white hover:pl-2.5">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-neutral-400 group-hover:text-primary">01.</span>
                      <span class="text-xs sm:text-sm font-bold text-neutral-900 group-hover:text-primary transition-colors">Karavan Dönüşüm Projesi</span>
                    </div>
                    <span class="text-xs font-bold text-neutral-400 group-hover:text-primary transition-transform group-hover:translate-x-0.5">İncele →</span>
                  </a>
                  <a href="/arac-motor-degisim-projesi" class="group flex items-center justify-between py-3 px-1 transition-colors hover:bg-white hover:pl-2.5">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-neutral-400 group-hover:text-primary">02.</span>
                      <span class="text-xs sm:text-sm font-bold text-neutral-900 group-hover:text-primary transition-colors">Motor Değişimi & Ruhsata Tescil</span>
                    </div>
                    <span class="text-xs font-bold text-neutral-400 group-hover:text-primary transition-transform group-hover:translate-x-0.5">İncele →</span>
                  </a>
                  <a href="/ceki-demiri-projesi" class="group flex items-center justify-between py-3 px-1 transition-colors hover:bg-white hover:pl-2.5">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-neutral-400 group-hover:text-primary">03.</span>
                      <span class="text-xs sm:text-sm font-bold text-neutral-900 group-hover:text-primary transition-colors">Çeki Demiri Montaj Uygunluk</span>
                    </div>
                    <span class="text-xs font-bold text-neutral-400 group-hover:text-primary transition-transform group-hover:translate-x-0.5">İncele →</span>
                  </a>
                  <a href="/koltuk-sokum-projesi" class="group flex items-center justify-between py-3 px-1 transition-colors hover:bg-white hover:pl-2.5">
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-neutral-400 group-hover:text-primary">04.</span>
                      <span class="text-xs sm:text-sm font-bold text-neutral-900 group-hover:text-primary transition-colors">Koltuk Sökümü / Koltuk İlavesi</span>
                    </div>
                    <span class="text-xs font-bold text-neutral-400 group-hover:text-primary transition-transform group-hover:translate-x-0.5">İncele →</span>
                  </a>
                  <a href="/lpg-sokum-projesi" class="group flex items-center justify-between py-3 px-1 transition-colors hover:bg-white hover:pl-2.5">
