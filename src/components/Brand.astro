---
import { siteSettings } from '@/data/site'

interface Props {
  inverse?: boolean
}

const { inverse = false } = Astro.props
---

<a aria-label={`${siteSettings.brandName} ana sayfa`} class="inline-flex items-center group/brand py-1" href="/">
  <span
    class={`text-lg sm:text-xl md:text-2xl font-black tracking-[-0.04em] transition-colors duration-300 ${
      inverse
        ? 'text-white'
        : 'text-foreground group-data-[sticky=true]/header:text-foreground'
    }`}
  >
    {siteSettings.brandName}
  </span>
</a>
