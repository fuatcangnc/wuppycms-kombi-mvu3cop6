---
import { Icon } from 'astro-icon/components'
import { phoneHref, siteSettings, whatsappHref } from '@/data/site'
import SiteImage from './SiteImage.astro'

interface Props {
  eyebrow?: string
  title?: string
  description?: string
  whatsappText?: string
  showAllServicesButton?: boolean
}

const {
  eyebrow = 'TSE Yetkili Araç Proje Ofisi',
  title = 'Aracınızı ve Motosikletinizi Güvenle Trafiğe Hazırlayın.',
  description = 'TSE onaylı araç projesi, karavan dönüşümü, motor değişimi, çeki demiri ve kurye taşıma kutusu tescilinde hızlı, güvenilir ve garantili makine mühendisliği desteği sunuyoruz.',
  whatsappText = 'Merhaba, araç projesi ve motosiklet çanta tescil hizmetleriniz hakkında bilgi almak istiyorum.',
  showAllServicesButton = true,
} = Astro.props
---

<!-- CTA Banner Component -->
<section class="relative overflow-hidden bg-white text-neutral-950 [content-visibility:auto] [contain-intrinsic-size:auto_700px]">
  <!-- Left Side Image on Desktop (Completely removed on mobile/tablet to ensure clean background and no text collision) -->
  <SiteImage
    class="cta-mechanic-image hidden lg:block absolute bottom-0 left-0 z-0 h-auto w-[55%] max-w-[620px] object-contain object-left pointer-events-none select-none"
    src="/arac-proje-cta.webp"
    alt="Araç projesi ve motosiklet çanta tescil desteği"
    widths={[420, 560, 620]}
    sizes="(min-width: 1024px) 55vw, 1px"
    loading="lazy"
    width="620"
    height="380"
    quality={75}
  />

  <div class="shell relative isolate grid min-h-[24rem] lg:min-h-[26rem] overflow-hidden lg:grid-cols-[.9fr_1.1fr] lg:gap-8 items-center">
    <!-- Left Column Spacer for desktop grid -->
    <div class="col-start-1 hidden lg:block" aria-hidden="true"></div>

    <!-- Right Column: Content -->
    <div class="relative z-10 flex flex-col justify-center gap-5 py-12 pl-0 lg:col-start-2 lg:py-14 lg:pl-6">
      <span class="text-xs font-black uppercase tracking-[.18em] text-primary">{eyebrow}</span>
      <h2 class="max-w-2xl text-3xl sm:text-4xl font-black uppercase leading-[1.02] tracking-[-0.04em] text-neutral-950 md:text-5xl">
        {title}
      </h2>
      <p class="max-w-xl text-sm leading-relaxed text-neutral-600">
        {description}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          class="inline-flex min-h-12 items-center justify-center gap-3 bg-primary hover:bg-[#b84d12] px-6 text-xs font-black uppercase tracking-wider !text-white transition-all duration-300 hover:scale-[1.02] shadow-md shadow-primary/20"
          href={whatsappHref(whatsappText)}
          target="_blank"
          rel="noreferrer"
        >
          <span>WhatsApp ile Danışın</span>
          <Icon name="lucide:arrow-right" size={16} />
        </a>
        {showAllServicesButton && (
          <a
            class="inline-flex min-h-12 items-center justify-center gap-3 border-2 border-neutral-950 bg-transparent hover:bg-neutral-950 hover:!text-white px-6 text-xs font-black uppercase tracking-wider !text-neutral-950 transition-all duration-300 hover:scale-[1.02]"
            href="/arac-proje-hizmetlerimiz"
          >
            <span>Tüm Hizmetleri İnceleyin</span>
            <Icon name="lucide:arrow-right" size={16} />
          </a>
        )}
      </div>

      <!-- Phone Callout (At the bottom on both mobile and desktop) -->
      <div class="flex items-center gap-4 pt-3 sm:pt-2">
        <span class="grid size-12 sm:size-14 shrink-0 place-items-center bg-black text-white">
          <Icon name="lucide:wrench" size={22} class="sm:size-6" />
        </span>
        <div class="flex flex-col">
          <span class="text-xs font-black uppercase tracking-wider text-primary">Yardıma mı ihtiyacınız var?</span>
          <a
            href={phoneHref}
            class="mt-0.5 text-lg sm:text-2xl font-black uppercase !text-neutral-950 hover:!text-primary transition-colors inline-block"
          >
            Hemen Arayın: {siteSettings.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
  <!-- Custom geometric black dividers (Left & Right) -->
  <div class="custom-divider-black-left absolute -bottom-[1px] left-0 z-10 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
  <div class="custom-divider-black-right absolute -bottom-[1px] right-0 z-10 pointer-events-none border-0 outline-none shadow-none" aria-hidden="true"></div>
</section>

<style>
  @media (max-width: 1023px) {
    .cta-mechanic-image {
      display: none !important;
    }
  }
</style>
